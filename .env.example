# Preview is the default. Use .env.local locally; never commit credential values.
APP_ORIGIN=http://localhost:3000
COMMERCE_LIVE=false
MONGODB_URI=
CHECKOUT_COOKIE_SECRET=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Explicitly approved shipping destinations and minor-unit rates, e.g.
# SHIPPING_RATES_JSON={"US":{"USD":1500},"KE":{"KES":30000}}
SHIPPING_RATES_JSON=
TAX_POLICY_APPROVED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=
MPESA_CALLBACK_TOKEN=
MPESA_TAX_APPROVED=false
# Explicit approved tax in basis points; set 0 only if zero is appropriate.
MPESA_TAX_BASIS_POINTS=
CRON_SECRET=
NEXT_TELEMETRY_DISABLED=1
# Optional transactional notifications. Jobs stay queued until configured.
RESEND_API_KEY=
EMAIL_FROM=
