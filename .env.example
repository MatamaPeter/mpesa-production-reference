# Copy only when no local settings exist. Store real values in deployment secrets.
# Preview never requires credentials. Sandbox must use test providers.
APP_ORIGIN=http://localhost:3000
COMMERCE_LIVE=false
COMMERCE_STAGE=preview
MONGODB_URI=
DB_POOL_SIZE=30
CACHE_NAMESPACE=
CHECKOUT_COOKIE_SECRET=
CRON_SECRET=
AUTH_ENCRYPTION_KEY=
ACCOUNT_AUTH_ENABLED=false
# Temporary initial owner provisioning only; disable before live trading.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Approved ISO country -> currency -> integer minor-unit shipping amounts.
# Example only, NOT approved rates: {"KE":{"KES":30000}}
SHIPPING_RATES_JSON=
TAX_POLICY_APPROVED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=
MPESA_CALLBACK_TOKEN=
MPESA_TAX_APPROVED=false
MPESA_TAX_PROVIDER=flat
MPESA_TAX_BASIS_POINTS=
MPESA_ROUNDING_APPROVED=false
# Durable account, receipt and support messages; verify the sender domain.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_SANDBOX_RECIPIENT=
# Enable only after sandbox acceptance; worker also handles email/inventory expiry.
PAYMENT_WORKER_ENABLED=false
WORKER_APP_ORIGIN=http://localhost:3000
WORKER_INTERVAL_MS=10000
WORKER_CONCURRENCY=1
# Optional Shippo; purchasing labels is an explicit money-moving action.
SHIPPO_API_TOKEN=
SHIPPING_LABEL_PURCHASE_ENABLED=false
SHIPPING_TRACKING_ENABLED=false
SHIP_FROM_ADDRESS_JSON=
# Optional OpenExchangeRates; also enable site.fx in central configuration.
FX_API_KEY=
# Default media backend is GridFS. Use s3 for S3-compatible storage.
MEDIA_STORAGE=gridfs
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_TELEMETRY_DISABLED=1
