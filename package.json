{
  "name": "leron-urban-electronics",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx tests/commerce.test.ts",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src tests scripts next.config.ts playwright.config.ts",
    "format": "prettier --write src tests scripts next.config.ts playwright.config.ts",
    "test:integration": "node --import tsx tests/integration.mjs",
    "db:prepare": "node --env-file-if-exists=.env.local scripts/prepare-db.mjs",
    "test:load": "node tests/load.mjs",
    "worker": "node --env-file-if-exists=.env.local scripts/worker.mjs",
    "check:production": "node --env-file-if-exists=.env.local --import tsx scripts/check-production.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "mongodb": "^7.8.0",
    "mongoose": "^9.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "shippo": "^2.19.1",
    "stripe": "^23.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module"
}
